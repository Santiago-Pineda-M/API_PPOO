# PostgreSQL connection string (live Neon cloud DB): postgresql://user:password@hostname/database?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/apipoo?sslmode=require

# JWT secret, must be at least 32 characters
Jwt__Secret=replace-me-with-a-secret-of-at-least-32-characters

# Token issuer and audience
Jwt__Issuer=ApiPoo2
Jwt__Audience=ApiPoo2

# Token lifetimes
Jwt__AccessTokenTtlMinutes=15
Jwt__RefreshTokenTtlDays=7

# CORS: orígenes permitidos separados por coma (ej. http://localhost:3000,https://app.example.com).
# Sin configurar, el navegador bloquea el cross-origin; Postman/curl no se ven afectados.
Cors__AllowedOrigins=http://localhost:3000

# Primer administrador (solo se usa una vez, con la base vacía, vía POST /api/bootstrap/admin).
# TipoIdentificacion: 1-4 o CedulaCiudadania, CedulaExtranjeria, TarjetaIdentidad, Nit.
Bootstrap__TipoIdentificacion=1
Bootstrap__NumeroIdentificacion=1000000000
Bootstrap__Nombres=Admin
Bootstrap__Apellidos=Sistema
Bootstrap__CorreoElectronico=admin@example.com
# Contraseña del primer administrador (debe cumplir la política: 8-128 caracteres,
# mayúscula, minúscula, número y carácter especial). Cámbiala antes de usar la API.
Bootstrap__Password=Cambiar-Clave1!

# Geocodificación de paradas con OpenStreetMap Nominatim (gratuito, sin clave).
# Identificá el User-Agent con un contacto real y respetá ≤ 1 petición/segundo.
Geocoding__BaseUrl=https://nominatim.openstreetmap.org
Geocoding__UserAgent=API_PPOO/1.0 (contacto@example.com)
Geocoding__PaisCodigo=co
Geocoding__TimeoutSegundos=10
Geocoding__PausaEntreLlamadasMs=1100
Geocoding__MaxPorCiclo=10
Geocoding__CacheTtlHoras=24

# Cargue masivo de trayectos por Excel (E4).
Trayectos__Cargue__TamanioMaximoMb=5
Trayectos__Cargue__MaxFilas=5000
